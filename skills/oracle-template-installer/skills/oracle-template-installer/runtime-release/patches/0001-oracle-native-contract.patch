+def effective_default_attribute(profile, master_key, role, policy, attribute, level=1):
+    """Resolve a default using OOXML role inheritance, never placeholder idx."""
+    role = role if role in ROLES else "body"
+    shapes, styles = profile.masters[master_key]
+    style_kind = (
+        "titleStyle"
+        if role == "title"
+        else "bodyStyle"
+        if role == "body"
+        else "otherStyle"
+    )
+    candidates = [
+        policy.style.find(f"a:lvl{level}pPr/a:defRPr", NS),
+        shapes[role].find(f"p:txBody/a:lstStyle/a:lvl{level}pPr/a:defRPr", NS),
+        styles.find(f"p:{style_kind}/a:lvl{level}pPr/a:defRPr", NS),
+    ]
+    return next(
+        (
+            node.get(attribute)
+            for node in candidates
+            if node is not None and attribute in node.attrib
+        ),
+        None,
+    )
+
