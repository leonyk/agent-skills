+
+DML_NS = "http://schemas.openxmlformats.org/drawingml/2006/main"
+PML_NS = "http://schemas.openxmlformats.org/presentationml/2006/main"
+_PARAGRAPH_TAGS = {f"{{{DML_NS}}}pPr"} | {
+    f"{{{DML_NS}}}lvl{i}pPr" for i in range(1, 10)
+}
+
