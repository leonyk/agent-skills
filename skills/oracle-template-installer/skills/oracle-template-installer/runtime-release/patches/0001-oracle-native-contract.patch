+def _validate_image_background(reader: _PackageReader, part: str, root: ET.Element) -> None:
+    backgrounds = root.findall(f"{{{PML_NS}}}cSld/{{{PML_NS}}}bg")
+    if len(backgrounds) != 1:
+        reader.errors.append(f"{part}: image background requires exactly one p:bg")
+        return
+    fill = backgrounds[0].find(f"{{{PML_NS}}}bgPr/{{{DML_NS}}}blipFill")
+    blip = fill.find(f"{{{DML_NS}}}blip") if fill is not None else None
+    if fill is None or blip is None or not blip.get(f"{{{REL_NS}}}embed"):
+        reader.errors.append(f"{part}: explicit image background requires an embedded a:blipFill")
+        return
+    if (fill.find(f"{{{DML_NS}}}stretch/{{{DML_NS}}}fillRect") is None
+            or fill.find(f"{{{DML_NS}}}tile") is not None):
+        reader.errors.append(f"{part}: image background must use uncropped stretch")
+    crop = fill.find(f"{{{DML_NS}}}srcRect")
+    if crop is not None and any(value != "0" for value in crop.attrib.values()):
+        reader.errors.append(f"{part}: image background cannot be cropped")
+    content_types = reader.xml("[Content_Types].xml")
+    declarations = list(content_types) if content_types is not None else []
+    defaults = {n.get("Extension"): n.get("ContentType", "") for n in declarations if n.tag.endswith("}Default")}
+    overrides = {n.get("PartName"): n.get("ContentType", "") for n in declarations if n.tag.endswith("}Override")}
+    relations = {r.rel_id: r for r in reader.relationships(part)}
+    for node in fill.iter():
+        for attr, rid in node.attrib.items():
+            if not attr.startswith("{" + REL_NS + "}"):
+                continue
+            relation = relations.get(rid)
+            if relation is None or not relation.rel_type.endswith("/image"):
+                reader.errors.append(f"{part}: image background references missing/non-image relationship {rid}")
+                continue
+            target = _resolve_relationship_target(part, relation, reader.errors, f"{part} background")
+            if target is not None:
+                if target not in reader.names:
+                    reader.errors.append(f"{part}: image background target is missing: {target}")
+                content_type = overrides.get("/" + target, defaults.get(PurePosixPath(target).suffix[1:], ""))
+                if not content_type.startswith("image/"):
+                    reader.errors.append(f"{part}: background target lacks an image content type: {target}")
 
 
