+    styles = elements.find(_tag("fmtScheme"))
+    assert styles is not None
+    if [node.tag for node in styles] != [_tag(name) for name in ("fillStyleLst", "lnStyleLst", "effectStyleLst", "bgFillStyleLst")]:
+        raise BrandThemeError(f"{source}: fmtScheme requires all four style lists")
+    if any(len(style_list) < 3 for style_list in styles):
+        raise BrandThemeError(f"{source}: each fmtScheme style list requires at least three entries")
+    return BrandTheme(payload, root.get("name", ""), tuple(palette))
+
+
+def load_brand_theme(resource_root: Path | None) -> BrandTheme | None:
+    """Read only this workspace's optional profile; reject path escapes."""
+    if resource_root is None:
+        return None
+    workspace = resource_root.resolve()
+    source = workspace / "templates" / BRAND_THEME_FILENAME
+    if not source.exists() and not source.is_symlink():
+        return None
+    if not source.resolve().is_relative_to(workspace) or not source.is_file():
+        raise BrandThemeError(f"Brand theme must be a file within its workspace: {source}")
+    return _parse_brand_theme(source.read_bytes(), source)
+
+
+def bind_brand_theme_colors(
+    profile: BrandTheme, spec: ThemeColorSpec | None,
+) -> ThemeColorSpec:
+    """Bind existing color roles to the profile before SVG color tokenization.
+
+    A role without an exact RGB match remains literal in the generated page.
+    For duplicate theme colors, retain the role's previous slot when possible,
+    then prefer the first slot in profile order. Never allocate a new slot or
+    reinterpret an existing slot merely to accommodate a project color.
+    """
+    slots = dict(profile.scheme_colors)
+    roles: dict[str, str] = {}
+    role_slots: dict[str, str] = {}
+    if spec is not None:
+        for role, color in spec.roles.items():
+            if role not in spec.role_slots:
+                continue
+            matches = [slot for slot, value in profile.scheme_colors if value == color]
+            if not matches:
+                continue
+            roles[role] = color
+            previous = spec.role_slots[role]
+            role_slots[role] = previous if previous in matches else matches[0]
+    return ThemeColorSpec(
+        slots=slots,
+        roles=roles,
+        role_slots=role_slots,
+        extra_roles=tuple(role for role in spec.extra_roles if role in roles) if spec else (),
+    )
+
+
+def apply_brand_theme(extract_dir: Path, profile: BrandTheme) -> int:
+    """Replace generated Theme parts, preserving names and package relationships.
+
+    Validate every target before writing. Theme parts with their own nonempty
+    relationship files are source-bearing packages and are refused. The caller
+    owns export-mode gating and applies this after any generated Theme defaults.
+    """
+    package = extract_dir.resolve()
+    targets = sorted(
+        path for path in (package / "ppt" / "theme").glob("theme*.xml")
+        if re.fullmatch(r"theme[0-9]+\.xml", path.name)
+    )
+    if not targets:
+        raise BrandThemeError("Generated PPTX package has no Theme parts")
+    for target in targets:
+        if not target.resolve().is_relative_to(package):
+            raise BrandThemeError(f"Theme target escapes the generated package: {target}")
+        try:
+            if ET.parse(target).getroot().tag != _tag("theme"):
+                raise BrandThemeError(f"Generated Theme target is not a:theme: {target}")
+            rels = target.parent / "_rels" / f"{target.name}.rels"
+            if rels.exists():
+                if not rels.resolve().is_relative_to(package) or len(ET.parse(rels).getroot()):
+                    raise BrandThemeError(f"Cannot replace a Theme with package relationships: {target}")
+        except ET.ParseError as exc:
+            raise BrandThemeError(f"Cannot read generated Theme target {target}: {exc}") from exc
+    for target in targets:
+        target.write_bytes(profile.payload)
+    return len(targets)
