@@ -0,0 +1,101 @@
+"""Validate portable Brand assets and bind authored SVG role declarations."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+from xml.etree import ElementTree as ET
+
+BRAND_ASSETS_FILENAME = "brand_assets.json"
+_ROLE = re.compile(r"[a-zA-Z][a-zA-Z0-9_.-]{0,63}")
+
+
+@dataclass(frozen=True)
+class BrandAssets:
+    assets: dict[str, str]
+    colors: dict[str, str]
+
+
+def _unique_members(pairs: list[tuple[str, object]]) -> dict:
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"Duplicate Brand manifest member {key!r}")
+        result[key] = value
+    return result
+
+
+def load_brand_assets(workspace: Path) -> BrandAssets | None:
+    manifest = workspace / "templates" / BRAND_ASSETS_FILENAME
+    if not manifest.exists():
+        return None
+    root = workspace.resolve()
+    if not manifest.resolve().is_relative_to(root):
+        raise ValueError("Brand asset manifest escapes its workspace")
+    data = json.loads(manifest.read_text(encoding="utf-8"), object_pairs_hook=_unique_members)
+    if (not isinstance(data, dict)
+            or data.get("schema") != "ppt-master.brand-assets.v1"
+            or set(data) - {"schema", "assets", "colors"}
+            or not isinstance(data.get("assets"), dict)
+            or not isinstance(data.get("colors", {}), dict)):
+        raise ValueError("Invalid ppt-master.brand-assets.v1 manifest")
+    assets = {}
+    for role, value in data["assets"].items():
+        if not _ROLE.fullmatch(role) or not isinstance(value, dict) or set(value) != {"path", "sha256"}:
+            raise ValueError(f"Invalid Brand asset role {role!r}")
+        raw, digest = value["path"], value["sha256"]
+        if not isinstance(raw, str) or not isinstance(digest, str):
+            raise ValueError(f"Invalid Brand asset path/hash for {role!r}")
+        path = PurePosixPath(raw)
+        if (path.is_absolute() or len(path.parts) < 2 or path.parts[0] != "images"
+                or ".." in path.parts or "\\" in raw or ":" in raw or raw != path.as_posix()):
+            raise ValueError(f"Brand asset {role!r} must use a portable images/ path")
+        source = (root / raw).resolve()
+        if not source.is_relative_to(root) or not source.is_file():
+            raise ValueError(f"Brand asset {role!r} is missing or escapes its workspace")
+        if not re.fullmatch(r"[0-9a-f]{64}", digest) or hashlib.sha256(source.read_bytes()).hexdigest() != digest:
+            raise ValueError(f"Brand asset {role!r} sha256 mismatch")
+        assets[role] = raw
+    colors = data.get("colors", {})
+    for role, value in colors.items():
+        if not _ROLE.fullmatch(role) or not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
+            raise ValueError(f"Invalid Brand color role {role!r}")
+    return BrandAssets(assets, colors)
+
+
+def bind_brand_assets(
+    source: Path, destination: Path, project: Path, brand: BrandAssets, *, allow_binding: bool = True,
+) -> bytes:
+    original = source.read_bytes()
+    root = ET.fromstring(original)
+    if not allow_binding and any(node.get(attr) is not None for node in root.iter()
+                                 for attr in ("data-pptx-brand-asset", "data-pptx-brand-fill")):
+        raise ValueError("Brand asset binding requires authored templates; mirror sources cannot be rebound")
+    changed = False
+    for node in root.iter():
+        role = node.get("data-pptx-brand-asset")
+        if role is not None:
+            if role not in brand.assets:
+                raise ValueError(f"{source.name}: Brand asset role {role!r} is missing")
+            if node.tag.rsplit("}", 1)[-1] != "image":
+                raise ValueError(f"{source.name}: Brand asset role {role!r} requires an image slot")
+            href = Path(os.path.relpath(project / brand.assets[role], destination.parent)).as_posix()
+            node.set("href", href)
+            node.attrib.pop("{http://www.w3.org/1999/xlink}href", None)
+            changed = True
+        role = node.get("data-pptx-brand-fill")
+        if role is not None:
+            if role not in brand.colors:
+                raise ValueError(f"{source.name}: Brand color role {role!r} is missing")
+            if "fill" in {p.split(":", 1)[0].strip() for p in node.get("style", "").split(";")}:
+                raise ValueError(f"{source.name}: Brand fill slot must use a fill attribute, not inline style")
+            node.set("fill", brand.colors[role])
+            changed = True
+    if not changed:
+        return original
+    ET.register_namespace("", "http://www.w3.org/2000/svg")
+    ET.register_namespace("xlink", "http://www.w3.org/1999/xlink")
+    return ET.tostring(root, encoding="utf-8") + b"\n"
