+        len(v) != 1 for v in actual_shapes.values()
+    ):
+        errors.append(f"Master {key}: expected exactly five native placeholder roles")
+    for role, expected in shapes.items():
+        actual = actual_shapes.get(ROLES[role], [])
+        if len(actual) != 1:
+            continue
