+def validate_defaults_slot(
+    profile, spec, item, layout_shape, slide_shapes, master_root, errors
+):
+    """Check effective geometry and explicit sparse ownership, independently."""
+    context = f"{spec.layout_key}/{item.element_id}"
+    policy = profile.slot(spec, item)
+    role = item.placeholder if item.placeholder in ROLES else "body"
+    master_shape = next(
+        (
+            s
+            for s in master_root.findall("p:cSld/p:spTree/p:sp", NS)
+            if (
+                s.find(".//p:ph", NS) is not None
+                and s.find(".//p:ph", NS).get("type") == ROLES[role]
+            )
