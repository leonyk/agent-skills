+        # Nested rich text declarations and explicit metadata authorize locals.
+        allowed = set()
+        mapping = {
+            "font-size": {"size"},
+            "font-weight": {"bold"},
+            "font-style": {"italic"},
+            "font-family": {"latin", "ea", "cs"},
+            "fill": {"color"},
+            "opacity": {"color"},
+            "fill-opacity": {"color"},
+            "text-decoration": {"underline", "strike"},
+            "letter-spacing": {"tracking"},
+            "baseline-shift": {"baseline"},
+        }
+        carrier = next(
+            (n for n in slot.iter() if n.get("data-pptx-carrier") == "true"), None
+        )
+        if carrier is not None:
+            for n in carrier.iter():
+                allowed.update(filter(None, n.get("data-pptx-local", "").split(",")))
+                if n is not carrier:
+                    for attr, tokens in mapping.items():
+                        if attr in n.attrib or attr + ":" in n.get("style", "").replace(
+                            " ", ""
+                        ):
+                            allowed.update(tokens)
+        for props in shape.findall("p:txBody//a:rPr", NS):
+            for token, attr in RUN_ATTRIBUTES.items():
+                if (
+                    token in policy.inherits
+                    and token not in allowed
+                    and attr in props.attrib
+                ):
+                    errors.append(context + ": unexpected Slide local " + token)
+            for token, tags in RUN_CHILDREN.items():
+                if (
+                    token in policy.inherits
+                    and token not in allowed
+                    and any(props.find("a:" + t, NS) is not None for t in tags)
+                ):
+                    errors.append(context + ": unexpected Slide local " + token)
+
