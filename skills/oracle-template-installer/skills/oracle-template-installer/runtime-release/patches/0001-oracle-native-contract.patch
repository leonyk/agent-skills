+    if [node.tag for node in elements] != [_tag(name) for name in ("clrScheme", "fontScheme", "fmtScheme")]:
+        raise BrandThemeError(f"{source}: themeElements must contain clrScheme, fontScheme and fmtScheme in order")
+    colors = elements.find(_tag("clrScheme"))
+    assert colors is not None
+    if [node.tag for node in colors] != [_tag(name) for name in _COLOR_SLOTS]:
+        raise BrandThemeError(f"{source}: clrScheme must declare all 12 color slots in DrawingML order")
+    palette = []
+    for slot, node in zip(_COLOR_SLOTS, colors):
+        if len(node) != 1 or node[0].tag not in {_tag("srgbClr"), _tag("sysClr")}:
+            raise BrandThemeError(f"{source}: {slot} requires one srgbClr or sysClr with a concrete fallback")
+        color = node[0].get("lastClr" if node[0].tag == _tag("sysClr") else "val", "")
+        if not _HEX_COLOR.fullmatch(color) or len(node[0]):
+            raise BrandThemeError(f"{source}: {slot} requires an untransformed six-digit RGB value")
+        palette.append((slot, color.upper()))
+    fonts = elements.find(_tag("fontScheme"))
+    assert fonts is not None
+    if [node.tag for node in fonts] != [_tag("majorFont"), _tag("minorFont")]:
+        raise BrandThemeError(f"{source}: fontScheme requires majorFont and minorFont")
+    for font in fonts:
+        if [node.tag for node in font][:3] != [_tag(name) for name in ("latin", "ea", "cs")]:
