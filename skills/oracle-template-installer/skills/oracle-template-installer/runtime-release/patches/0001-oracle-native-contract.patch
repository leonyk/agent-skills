+def preview_anchor_sizes(resource_root: Path, svg_files: list[Path]):
+    """Read provisional preview sizes from named slots, never project typography."""
+    path = Path(resource_root) / "templates" / "master_defaults.json"
+    if not path.is_file():
+        return None
+    data = json.loads(path.read_text(encoding="utf-8"))
+    anchors = data.get("preview_anchors")
+    if anchors is None:
+        return None
