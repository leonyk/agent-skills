+def _bounds(shape):
+    x = shape.find("p:spPr/a:xfrm", NS)
+    if x is None:
+        return None
+    off, ext = x.find("a:off", NS), x.find("a:ext", NS)
+    if off is None or ext is None:
+        return None
+    return tuple(
+        int(n.get(k)) for n, k in [(off, "x"), (off, "y"), (ext, "cx"), (ext, "cy")]
+    )
