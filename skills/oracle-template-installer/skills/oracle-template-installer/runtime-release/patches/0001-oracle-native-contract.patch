+"""Explicit, portable native Master defaults for authored structured decks.
+
+Only declared ownership removes a local property. Visual equality never implies
+inheritance. XML snippets own native defaults; SVG remains the content carrier.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import re
+import uuid
+from dataclasses import dataclass, field
+from pathlib import Path
+from xml.etree import ElementTree as ET
+
+from ..drawingml.theme_colors import ThemeColorSpec
+from .template_language import bind_template_text_language
+from .template_structure import TemplateStructureError
+
+A = "http://schemas.openxmlformats.org/drawingml/2006/main"
+P = "http://schemas.openxmlformats.org/presentationml/2006/main"
+NS = {"a": A, "p": P}
+ROLES = {
+    "title": "title",
+    "body": "body",
+    "date": "dt",
+    "footer": "ftr",
+    "slide-number": "sldNum",
+}
+RUN_ATTRIBUTES = {
+    "size": "sz",
+    "bold": "b",
+    "italic": "i",
+    "underline": "u",
+    "strike": "strike",
+    "tracking": "spc",
+    "baseline": "baseline",
+}
+RUN_CHILDREN = {
+    "color": ("solidFill", "gradFill", "noFill"),
+    "latin": ("latin",),
+    "ea": ("ea",),
+    "cs": ("cs",),
+}
+PAR_ATTRIBUTES = {"indent": ("marL", "marR", "indent"), "align": ("algn",)}
+PAR_CHILDREN = {
+    "line-spacing": ("lnSpc",),
+    "space-before": ("spcBef",),
+    "space-after": ("spcAft",),
+    "bullet": (
+        "buNone",
+        "buAutoNum",
+        "buChar",
+        "buFont",
+        "buClr",
+        "buClrTx",
+        "buSzPct",
+        "buSzPts",
+        "buSzTx",
+    ),
+}
+GROUPS = {
+    "text.size": ("size",),
+    "text.faces": ("latin", "ea", "cs"),
+    "text.bold": ("bold",),
+    "text.italic": ("italic",),
+    "text.color": ("color",),
+    "text.decoration": ("underline", "strike"),
+    "text.tracking": ("tracking",),
+    "text.baseline": ("baseline",),
+    "paragraph.spacing": ("line-spacing", "space-before", "space-after"),
+    "paragraph.list": ("bullet", "indent"),
+    "paragraph.align": ("align",),
+    "body.insets": ("lIns", "rIns", "tIns", "bIns"),
+    "body.anchor": ("anchor", "anchorCtr"),
+    "body.layout": ("wrap", "vert", "rtlCol", "autofit"),
+    "geometry": ("geometry",),
+}
+TOKENS = (
+    set(RUN_ATTRIBUTES)
+    | set(RUN_CHILDREN)
+    | set(PAR_ATTRIBUTES)
+    | set(PAR_CHILDREN)
+    | {
+        "geometry",
+        "lIns",
+        "rIns",
+        "tIns",
+        "bIns",
+        "anchor",
+        "anchorCtr",
+        "wrap",
+        "vert",
+        "rtlCol",
+        "autofit",
+    }
+)
+_ALLOWED = {
+    "sp",
+    "nvSpPr",
+    "cNvPr",
+    "cNvSpPr",
+    "nvPr",
+    "ph",
+    "spPr",
+    "txBody",
+    "bodyPr",
+    "lstStyle",
+    "p",
+    "pPr",
+    "r",
+    "rPr",
+    "t",
+    "fld",
+    "endParaRPr",
+    "txStyles",
+    "titleStyle",
+    "bodyStyle",
+    "otherStyle",
+    "defPPr",
+    "defRPr",
+    "xfrm",
+    "off",
+    "ext",
+    "prstGeom",
+    "avLst",
+    "noFill",
+    "solidFill",
+    "schemeClr",
+    "srgbClr",
+    "ln",
+    "noAutofit",
+    "normAutofit",
+    "spAutoFit",
+    "spLocks",
+    "lnSpc",
+    "spcBef",
+    "spcAft",
+    "spcPts",
+    "spcPct",
+    "buNone",
+    "buAutoNum",
+    "buChar",
+    "buFont",
+    "buClr",
+    "buClrTx",
+    "buSzPct",
+    "buSzPts",
+    "buSzTx",
+    "tabLst",
+    "tab",
+    "latin",
+    "ea",
+    "cs",
+    "clrMapOvr",
+    "overrideClrMapping",
+    "masterClrMapping",
+} | {f"lvl{i}pPr" for i in range(1, 10)}
+
+
+_PRESENTATION_ELEMENTS = {
+    "sp",
+    "nvSpPr",
+    "cNvPr",
+    "cNvSpPr",
+    "nvPr",
+    "ph",
+    "spPr",
+    "txBody",
+    "txStyles",
+    "titleStyle",
+    "bodyStyle",
+    "otherStyle",
+    "clrMapOvr",
+}
+
+
+_ALLOWED.update({"bg", "bgPr", "bgRef", "effectLst"})
+_PRESENTATION_ELEMENTS.update({"bg", "bgPr", "bgRef"})
+
+
+def clone(node):
+    return copy.deepcopy(node)
+
+
+def _append_before_extensions(parent, child):
+    position = next(
+        (
+            i
+            for i, existing in enumerate(parent)
+            if existing.tag.rsplit("}", 1)[-1] == "extLst"
+        ),
+        len(parent),
+    )
+    parent.insert(position, child)
+
+
+def _error(message):
+    raise TemplateStructureError("Master defaults: " + message)
+
+
+def _keys(value, required, optional=()):
+    if (
+        not isinstance(value, dict)
+        or set(value) - set(required) - set(optional)
+        or set(required) - set(value)
+    ):
+        _error(
+            f"expected keys {sorted(required)} (optional {sorted(optional)}), got {value!r}"
+        )
+
+
+def _neutral_rgb(value):
+    return (
+        bool(re.fullmatch(r"[0-9A-Fa-f]{6}", value))
+        and value[0:2].upper() == value[2:4].upper() == value[4:6].upper()
+    )
+
+
+def _xml(template_dir, relative, root_tag, bindings):
+    if not isinstance(relative, str):
+        _error("snippet path must be a string")
+    path = (template_dir / relative).resolve()
+    if not path.is_relative_to(template_dir.resolve()) or not path.is_file():
+        _error(f"snippet must exist within templates/: {relative!r}")
+    data = path.read_text(encoding="utf-8")
+    if "<!DOCTYPE" in data or "<!ENTITY" in data:
+        _error(f"entities are forbidden: {relative}")
+    try:
+        root = ET.fromstring(data)
+    except ET.ParseError as exc:
+        _error(f"invalid snippet {relative}: {exc}")
+    if root.tag != root_tag:
+        _error(f"{relative} has incorrect root {root.tag}")
+    for node in root.iter():
+        local = node.tag.rsplit("}", 1)[-1]
+        if (
+            local not in _ALLOWED
+            or node.tag
+            != "{" + (P if local in _PRESENTATION_ELEMENTS else A) + "}" + local
+        ):
+            _error(f"unsupported XML element {node.tag} in {relative}")
+        bound_color = False
+        for key, value in list(node.attrib.items()):
+            if key.startswith("{"):
+                _error(f"namespaced attributes/relationships forbidden in {relative}")
+            if "${" in value:
+                token = value.removeprefix("${").removesuffix("}")
+                is_size = key == "sz" and token in {"title_hpt", "body_hpt"}
+                is_color = (
+                    local == "srgbClr" and key == "val" and token.startswith("color.")
+                )
+                if (
+                    not (is_size or is_color)
+                    or token not in bindings
+                    or value != "${" + token + "}"
+                ):
+                    _error(f"unsupported parameter {value!r} in {relative}")
+                bound_color = is_color
+                node.set(key, str(bindings[token]))
+        if local in {"latin", "ea", "cs", "buFont"} and not re.fullmatch(
+            r"\+(?:mj|mn)-(?:lt|ea|cs)", node.get("typeface", "")
+        ):
+            _error(f"only theme font references are allowed: {relative}")
+        if (
+            local == "srgbClr"
+            and not bound_color
+            and not _neutral_rgb(node.get("val", ""))
+        ):
+            _error(
+                f"only neutral literal colors or scheme colors are allowed: {relative}"
+            )
+    return root
+
+
+def _read_background(directory, relative, bindings):
+    root = _xml(directory, relative, "{" + P + "}bg", bindings)
+    if root.attrib or len(root) != 1:
+        _error("background must contain exactly one bgPr or bgRef")
+    content = root[0]
+    if content.tag == "{" + P + "}bgRef":
+        if set(content.attrib) != {"idx"} or content.get("idx") not in {
+            "1001",
+            "1002",
+            "1003",
+        }:
+            _error(
+                "background reference must select background style 1001, 1002, or 1003"
+            )
+        colors = list(content)
+    elif content.tag == "{" + P + "}bgPr":
+        if content.attrib or [n.tag for n in content] not in (
+            ["{" + A + "}solidFill"],
+            ["{" + A + "}solidFill", "{" + A + "}effectLst"],
+        ):
+            _error(
+                "background properties support only a solid theme fill and optional empty effectLst"
+            )
+        if len(content) == 2 and (content[1].attrib or len(content[1])):
+            _error("background effectLst must be empty")
+        colors = list(content[0])
+    else:
+        _error("background must contain bgPr or bgRef")
+    if (
+        len(colors) != 1
+        or colors[0].tag != "{" + A + "}schemeClr"
+        or colors[0].attrib not in ({"val": "bg1"}, {"val": "bg2"})
+        or len(colors[0])
+    ):
+        _error("background must use one untransformed bg1 or bg2 theme alias")
+    return root
+
+
+def _set_background(root, background):
+    slide = root.find("p:cSld", NS)
+    previous = slide.find("p:bg", NS)
+    if previous is not None:
+        slide.remove(previous)
+    slide.insert(0, clone(background))
+
+
+@dataclass(frozen=True)
+class SlotDefaults:
+    geometry: str
+    body: ET.Element
+    style: ET.Element
+    inherits: frozenset[str]
+
+
+@dataclass(frozen=True)
+class MasterDefaults:
+    masters: dict
+    layouts: dict
+    slots: dict[tuple[str, str], SlotDefaults]
+    source: Path
+    master_backgrounds: dict[str, ET.Element] = field(default_factory=dict)
+
+    def slot(self, spec, item):
+        return self.slots[(spec.layout_key, item.element_id)]
+
+    def master_names(self, key):
+        return tuple("Native Master " + role for role in ROLES)
+
+    def optional_date_idx(self, key):
+        return self.layouts[key].get("optional_date_idx")
+
+    def background(self, kind, key):
+        return (
+            self.master_backgrounds.get(key)
+            if kind == "master"
+            else self.layouts[key].get("background_xml")
+        )
+
+    def install_master(self, key, root):
+        background = self.background("master", key)
+        if background is not None:
+            _set_background(root, background)
+        shapes, styles = self.masters[key]
+        tree = root.find("p:cSld/p:spTree", NS)
+        next_id = (
+            max(
+                (int(n.get("id", "1")) for n in root.iter("{" + P + "}cNvPr")),
+                default=1,
+            )
+            + 1
+        )
+        for role in ROLES:
+            shape = clone(shapes[role])
+            props = shape.find("p:nvSpPr/p:cNvPr", NS)
+            props.set("id", str(next_id))
+            next_id += 1
+            props.set("name", "Native Master " + role)
+            _append_before_extensions(tree, shape)
+        old = root.find("p:txStyles", NS)
+        if old is not None:
+            root.remove(old)
+        _append_before_extensions(root, clone(styles))
+
+    def layout_shape(self, spec, item, shape, source_shape):
+        policy = self.slot(spec, item)
+        sp = shape.find("p:spPr", NS)
+        if policy.geometry == "inherit":
+            for node in list(sp):
+                if node.tag == "{" + A + "}xfrm":
+                    sp.remove(node)
+        tx = shape.find("p:txBody", NS)
+        tx.clear()
+        tx.extend([clone(policy.body), clone(policy.style)])
+        paragraph = ET.SubElement(tx, "{" + A + "}p")
+        if item.placeholder in {"date", "slide-number"}:
+            run = ET.SubElement(
+                paragraph,
+                "{" + A + "}fld",
+                {
+                    "id": "{" + str(uuid.uuid4()).upper() + "}",
+                    "type": "slidenum"
+                    if item.placeholder == "slide-number"
+                    else "datetime1",
+                },
+            )
+        else:
+            run = ET.SubElement(paragraph, "{" + A + "}r")
+        if item.placeholder == "footer":
+            text = "".join(
+                node.text or "" for node in source_shape.findall("p:txBody//a:t", NS)
+            )
+            # The converter uses one zero-width run for an empty carrier.
+            if text == "\u200b":
+                text = ""
+        elif item.placeholder == "slide-number":
+            text = "‹#›"
+        else:
+            text = "Click to add " + str(item.placeholder)
+        ET.SubElement(run, "{" + A + "}t").text = text
+
+    def finish_layout(self, key, root):
+        plan = self.layouts[key]
+        background = self.background("layout", key)
+        if background is not None:
+            _set_background(root, background)
+        mapping = plan.get("color_map_xml")
+        if mapping is not None:
+            old = root.find("p:clrMapOvr", NS)
+            if old is not None:
+                root.remove(old)
+            root.insert(1, clone(mapping))
+        idx = self.optional_date_idx(key)
+        if idx is not None:
+            master_key = plan["master"]
+            shape = clone(self.masters[master_key][0]["date"])
+            shape.find("p:nvSpPr/p:cNvPr", NS).set("name", "Optional Date Placeholder")
+            tree = root.find("p:cSld/p:spTree", NS)
+            shape.find("p:nvSpPr/p:cNvPr", NS).set(
+                "id",
+                str(
+                    max(int(n.get("id", "1")) for n in root.iter("{" + P + "}cNvPr"))
+                    + 1
+                ),
+            )
+            shape.find(".//p:ph", NS).set("idx", str(idx))
+            shape.find("p:spPr", NS).clear()
+            tx = shape.find("p:txBody", NS)
+            tx.clear()
+            date_policy = plan.get("optional_date_defaults")
+            if date_policy is None:
+                ET.SubElement(tx, "{" + A + "}bodyPr")
+                ET.SubElement(tx, "{" + A + "}lstStyle")
+            else:
+                tx.extend([clone(date_policy.body), clone(date_policy.style)])
+            p = ET.SubElement(tx, "{" + A + "}p")
+            f = ET.SubElement(
+                p,
+                "{" + A + "}fld",
+                {"id": "{" + str(uuid.uuid4()).upper() + "}", "type": "datetime1"},
+            )
+            ET.SubElement(f, "{" + A + "}t").text = "Date"
+            _append_before_extensions(tree, shape)
+
+    def inherits_geometry(self, spec, item):
+        svg = ET.parse(spec.svg_path).getroot()
+        slot = next(n for n in svg.iter() if n.get("id") == item.element_id)
+        return "geometry" in self.slot(
+            spec, item
+        ).inherits and "geometry" not in slot.get("data-pptx-local", "").split(",")
+
+    def slide_shape(self, spec, item, shape):
+        policy = self.slot(spec, item)
+        svg = ET.parse(spec.svg_path).getroot()
+        slot = next(n for n in svg.iter() if n.get("id") == item.element_id)
+        slot_local = set(filter(None, slot.get("data-pptx-local", "").split(",")))
+        if slot_local - {"geometry"}:
+            _error(f"{item.element_id}: unsupported slot local properties")
+        if "geometry" in policy.inherits and "geometry" not in slot_local:
+            for parent in shape.iter():
+                for child in list(parent):
+                    if child.tag == "{" + A + "}xfrm":
+                        parent.remove(child)
+        tx = shape.find("p:txBody", NS)
+        if tx is None:
+            return
+        bp = tx.find("a:bodyPr", NS)
+        for token in policy.inherits:
+            if token in {
+                "lIns",
+                "rIns",
+                "tIns",
+                "bIns",
+                "anchor",
+                "anchorCtr",
+                "wrap",
+                "vert",
+                "rtlCol",
+            }:
+                bp.attrib.pop(token, None)
+        if "autofit" in policy.inherits:
+            for child in list(bp):
+                if child.tag.rsplit("}", 1)[-1] in {
+                    "noAutofit",
+                    "normAutofit",
+                    "spAutoFit",
+                }:
+                    bp.remove(child)
+        for props in tx.iter():
+            local_tag = props.tag.rsplit("}", 1)[-1]
+            if local_tag not in {"pPr", "rPr", "defRPr", "endParaRPr"}:
+                continue
+            marker = props.attrib.pop("data-pptx-local", None)
+            # Converter-owned defaults carry provenance. Empty endParaRPr is safe.
+            if marker is None and local_tag in {"rPr", "pPr"}:
+                _error(
+                    f'{spec.svg_path.name}/{item.element_id}: missing {local_tag} provenance; mark the text carrier data-pptx-native-defaults="true"'
+                )
+            local = set(filter(None, (marker or "").split(",")))
+            if local - TOKENS:
+                _error(f"unsupported local properties: {sorted(local - TOKENS)}")
+            omitted = policy.inherits - local
+            attrs = RUN_ATTRIBUTES if local_tag != "pPr" else PAR_ATTRIBUTES
+            children = RUN_CHILDREN if local_tag != "pPr" else PAR_CHILDREN
+            for token, names in attrs.items():
+                if token in omitted:
+                    for name in names if isinstance(names, tuple) else (names,):
+                        props.attrib.pop(name, None)
+            for token, names in children.items():
+                if token in omitted:
+                    for child in list(props):
+                        if child.tag.rsplit("}", 1)[-1] in names:
+                            props.remove(child)
+        if item.placeholder == "slide-number":
+            for paragraph in tx.findall("a:p", NS):
+                for run in list(paragraph):
+                    if run.tag == "{" + A + "}r":
+                        run.tag = "{" + A + "}fld"
+                        run.set("type", "slidenum")
+                        run.set("id", "{" + str(uuid.uuid4()).upper() + "}")
+
+
+def load_master_defaults(
+    resource_root: Path, specs, text_style, theme_color_spec=None, primary_language=None
+) -> MasterDefaults | None:
+    directory = Path(resource_root) / "templates"
+    path = directory / "master_defaults.json"
+    if not path.exists():
+        return None
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (ValueError, OSError) as exc:
+        _error(str(exc))
+    _keys(
+        data,
+        {"schema", "masters", "policies", "layouts"},
+        {"preview_anchors", "color_bindings", "preview_colors"},
+    )
+    if data["schema"] != "ppt-master.master-defaults.v1":
+        _error("unknown schema")
+    bindings = {"title_hpt": text_style.title_hpt, "body_hpt": text_style.body_hpt}
+    for name, binding in data.get("color_bindings", {}).items():
+        if not re.fullmatch(r"[a-z][a-z0-9_]*", name):
+            _error("invalid semantic color binding name")
+        _keys(binding, {"role", "fallback"})
+        fallback = binding["fallback"]
+        if not isinstance(fallback, str) or not _neutral_rgb(fallback):
+            _error("semantic color fallback must be a neutral grayscale RGB")
+        color = (
+            theme_color_spec.roles.get(binding["role"], fallback)
+            if theme_color_spec is not None
+            else fallback
+        )
+        if not isinstance(color, str) or not re.fullmatch(r"[0-9A-Fa-f]{6}", color):
+            _error("semantic color binding must resolve to a six-digit RGB")
+        bindings["color." + name] = color.upper()
+    if set(data["masters"]) != {s.master_key for s in specs}:
+        _error("Master roster mismatch")
+    if set(data["layouts"]) != {s.layout_key for s in specs}:
+        _error("Layout roster mismatch")
+    masters = {}
+    master_backgrounds = {}
+    for key, plan in data["masters"].items():
+        _keys(plan, {"placeholders", "text_styles"}, {"background"})
+        if "background" in plan:
+            master_backgrounds[key] = _read_background(
+                directory, plan["background"], bindings
+            )
+        if set(plan["placeholders"]) != set(ROLES):
+            _error("each Master requires all five roles")
+        shapes = {}
+        for role, relative in plan["placeholders"].items():
+            shape = _xml(directory, relative, "{" + P + "}sp", bindings)
+            ph = shape.find(".//p:ph", NS)
+            if ph is None or ph.get("type") != ROLES[role]:
+                _error("Master role/type mismatch")
+            shapes[role] = shape
+        styles = _xml(directory, plan["text_styles"], "{" + P + "}txStyles", bindings)
+        for kind, count in [("titleStyle", 1), ("bodyStyle", 9), ("otherStyle", 9)]:
+            node = styles.find("p:" + kind, NS)
+            if node is None or any(
+                node.find(f"a:lvl{i}pPr", NS) is None for i in range(1, count + 1)
+            ):
+                _error("incomplete Master text styles")
+        body_sizes = [
+            node.get("sz") for node in styles.findall("p:bodyStyle/*/a:defRPr", NS)
+        ]
+        if body_sizes != [str(bindings["body_hpt"])] * 9:
+            _error("body levels 1–9 must use the current project body_hpt")
+        masters[key] = (shapes, styles)
+    policies = {}
+    for key, plan in data["policies"].items():
+        _keys(plan, {"geometry", "body_properties", "list_style", "slide_inherits"})
+        if plan["geometry"] not in {"inherit", "svg-bounds"}:
+            _error("invalid geometry ownership")
+        tokens = set()
+        for group in plan["slide_inherits"]:
+            if group not in GROUPS and group not in TOKENS:
+                _error(f"unknown inherited property {group}")
+            tokens.update(GROUPS.get(group, (group,)))
+        policies[key] = SlotDefaults(
+            plan["geometry"],
+            _xml(directory, plan["body_properties"], "{" + A + "}bodyPr", bindings),
+            _xml(directory, plan["list_style"], "{" + A + "}lstStyle", bindings),
+            frozenset(tokens),
+        )
+    slots = {}
+    layouts = {}
+    for spec in specs:
+        plan = data["layouts"][spec.layout_key]
+        _keys(
+            plan,
+            {"master", "slots"},
+            {"optional_date_idx", "optional_date_policy", "color_map", "background"},
+        )
+        if plan["master"] != spec.master_key:
+            _error("Layout/Master binding mismatch")
+        if set(plan["slots"]) != {item.element_id for item in spec.placeholders}:
+            _error(f"{spec.layout_key}: slot roster mismatch")
+        for scope, has_snippet, items in (
+            ("Master", spec.master_key in master_backgrounds, spec.master_elements),
+            ("Layout", "background" in plan, spec.layout_elements),
+        ):
+            if has_snippet and any(item.is_background and item.tag == "image" for item in items):
