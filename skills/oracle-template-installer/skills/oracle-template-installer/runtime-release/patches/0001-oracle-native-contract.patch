+    for role in ("title", "body"):
+        anchor = anchors[role]
+        _keys(anchor, {"layout", "slot"})
+        root = roots.get(anchor["layout"])
+        if root is None:
+            _error("preview anchor Layout is missing")
+        slot = next((n for n in root.iter() if n.get("id") == anchor["slot"]), None)
+        if slot is None:
+            _error("preview anchor slot is missing")
+        carrier = next(
