+"""Portable, relationship-free Brand themes for newly generated PPTX packages.
+
+The optional ``templates/brand_theme.xml`` is a complete DrawingML Theme.
+It owns color slots, fonts, format styles, object defaults and custom colors;
+it owns no Master, Layout, placeholder geometry or slide content. Callers must
+not apply it to round-trip or source-preserving mirror exports.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from xml.etree import ElementTree as ET
+
+from ..drawingml.theme_colors import ThemeColorSpec
+
+
+BRAND_THEME_FILENAME = "brand_theme.xml"
+DML_NS = "http://schemas.openxmlformats.org/drawingml/2006/main"
+THEME_FAMILY_NS = "http://schemas.microsoft.com/office/thememl/2012/main"
+_COLOR_SLOTS = (
+    "dk1", "lt1", "dk2", "lt2", "accent1", "accent2", "accent3",
+    "accent4", "accent5", "accent6", "hlink", "folHlink",
+)
+_THEME_CHILDREN = (
+    "themeElements", "objectDefaults", "extraClrSchemeLst", "custClrLst", "extLst",
+)
+_HEX_COLOR = re.compile(r"[0-9A-Fa-f]{6}\Z")
+
+
+class BrandThemeError(ValueError):
+    """An optional Brand theme violates the portable Theme contract."""
+
+
+@dataclass(frozen=True)
+class BrandTheme:
+    """Validated Theme bytes plus the concrete, ordered color-slot mapping."""
+
+    payload: bytes
+    name: str
+    scheme_colors: tuple[tuple[str, str], ...]
+
+
+def _tag(name: str) -> str:
+    return f"{{{DML_NS}}}{name}"
+
+
+def _parse_brand_theme(payload: bytes, source: Path) -> BrandTheme:
+    try:
+        text = payload.decode("utf-8-sig")
+        if re.search(r"<!\s*(?:DOCTYPE|ENTITY)\b", text, re.IGNORECASE):
+            raise BrandThemeError(f"{source}: Theme cannot declare a DTD or entity")
+        root = ET.fromstring(text)
+    except (UnicodeDecodeError, ET.ParseError) as exc:
+        raise BrandThemeError(f"{source}: invalid UTF-8 Theme XML: {exc}") from exc
+    if root.tag != _tag("theme"):
+        raise BrandThemeError(f"{source}: root must be DrawingML a:theme")
+    for node in root.iter():
+        namespace, _, local = (
+            node.tag[1:].partition("}")
+            if node.tag.startswith("{") else ("", "", node.tag)
+        )
+        if namespace not in {DML_NS, THEME_FAMILY_NS}:
+            raise BrandThemeError(f"{source}: unsupported Theme namespace {namespace!r}")
+        if namespace == THEME_FAMILY_NS and local != "themeFamily":
+            raise BrandThemeError(f"{source}: unsupported Theme extension {local!r}")
